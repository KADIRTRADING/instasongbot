# Copy this file to `.env` and fill in real values before running the bot.
#   cp .env.example .env
#
# Every field here maps 1:1 to a Settings field in app/config.py — see that
# file's docstrings for the authoritative description of each one. Only
# BOT_TOKEN and DATABASE_URL have no default and are REQUIRED; everything
# else below is shown at its default value (safe to leave commented out /
# unchanged unless you need to override it) except where noted.
#
# NOTE: if you're using docker-compose.yml, it already sets DATABASE_URL,
# REDIS_URL, and WORKDIR to the correct in-network values for you (see that
# file) — you do NOT need to (and should NOT) set those three here when
# running via Compose. This file matters most for running the bot directly
# on a host (no Docker) or for docker-compose.prod.yml's webhook-mode
# variables, which nothing else sets for you.

# ============================================================================
# Telegram (REQUIRED)
# ============================================================================

# Get this from @BotFather on Telegram: /newbot, then copy the token it gives you.
BOT_TOKEN=123456789:AAAA-your-bot-token-from-botfather

# Your bot's @username, without the leading @. Used only as the
# {bot_username} placeholder in caption templates (see the admin panel's
# "Edit Captions" feature) -- optional, but templates look odd without it.
BOT_USERNAME=

# Comma-separated Telegram numeric user IDs allowed into the admin panel
# (/admin command and the "🛠 Admin Panel" menu button). Get your own numeric
# ID by messaging @userinfobot on Telegram. Example: ADMIN_IDS=111111111,222222222
# Leave blank and NOBODY can access the admin panel -- set this before you
# need it, not after.
ADMIN_IDS=

# false = long polling (default, recommended for a first deployment -- no
#   public URL or TLS certificate needed, see README's "Deployment" section).
# true  = webhook mode (needs WEBHOOK_BASE_URL below, a real HTTPS domain,
#   and either the bundled Caddy reverse proxy or your own).
USE_WEBHOOK=false

# Required only when USE_WEBHOOK=true. Public HTTPS base URL Telegram will
# POST updates to, e.g. https://bot.example.com (no trailing slash, no path).
WEBHOOK_BASE_URL=

# Path segment appended to WEBHOOK_BASE_URL for the actual webhook endpoint.
WEBHOOK_PATH=/webhook

# Strongly recommended whenever USE_WEBHOOK=true: a random secret Telegram
# echoes back in the X-Telegram-Bot-Api-Secret-Token header on every webhook
# POST, letting the bot reject forged requests from anyone else who
# discovers your webhook URL. Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=

# Host/port the bot's own aiohttp server binds to -- used for the webhook
# HTTP server (USE_WEBHOOK=true) AND for the small file-serving server that
# hands out large-file download links in long-polling mode when
# STORAGE_BACKEND=local (see app/file_server.py). 0.0.0.0 so Docker's port
# mapping can reach it; change WEB_SERVER_PORT if 8080 is already taken on
# your host.
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080

# Only set this if you're running your own self-hosted Local Bot API Server
# (https://github.com/tdlib/telegram-bot-api) to raise the 20MB getFile
# download ceiling up to 2000MB. Leave blank to use the standard
# https://api.telegram.org -- this is an advanced/optional feature, not
# needed for a normal deployment.
TELEGRAM_API_BASE_URL=

# ============================================================================
# Database (REQUIRED)
# ============================================================================

# postgresql+asyncpg://user:password@host:5432/dbname
# If you're using docker-compose.yml, leave this to the compose file's own
# value (postgres service, internal network) rather than setting it here.
DATABASE_URL=postgresql+asyncpg://instasongbot:instasongbot@localhost:5432/instasongbot
DB_POOL_SIZE=10
DB_ECHO=false

# ============================================================================
# Redis
# ============================================================================

# Backs the arq job queue, the rate limiter, and the probe/upload short-lived
# caches (see ARCHITECTURE.md §10 and app/bot/probe_cache.py). If you're
# using docker-compose.yml, leave this to the compose file's own value.
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# Music recognition
# ============================================================================

# "audd" (default) or "acrcloud" -- see ARCHITECTURE.md §6 for what's
# live-tested vs. implemented-per-spec for each provider.
RECOGNITION_PROVIDER=audd

# Get a free token at https://audd.io/ (or use "test" for AudD's own public
# test token while trying things out -- do NOT rely on "test" in production).
AUDD_API_TOKEN=

# Only needed if RECOGNITION_PROVIDER=acrcloud -- get these from your own
# ACRCloud console project (https://console.acrcloud.com/).
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

RECOGNITION_CLIP_SECONDS=15
RECOGNITION_TIMEOUT_SECONDS=20

# ============================================================================
# Downloads / conversion
# ============================================================================

# Bot API getFile ceiling; raise only if TELEGRAM_API_BASE_URL points at
# your own Local Bot API Server (see the Telegram section above).
MAX_TELEGRAM_FETCH_MB=20

# Above this size, a downloaded file is uploaded to storage and sent to the
# user as a secure temporary link instead of directly through Telegram.
TELEGRAM_DIRECT_UPLOAD_MB=50

# Hard cap on anything the worker will fetch from the internet, regardless
# of the platform's own reported size. Admins can further lower this
# per-platform or globally at runtime via the admin panel's "File Size
# Limits" menu -- this value is only the cold, env-sourced default.
MAX_DOWNLOAD_MB=500
DOWNLOAD_TIMEOUT_SECONDS=180
FFMPEG_TIMEOUT_SECONDS=180
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Optional cookies.txt files (operator-supplied, exported from your own
# logged-in browser session) to work around specific platforms' anonymous-
# access limitations -- see ARCHITECTURE.md §8's platform support matrix for
# which platforms currently benefit from this (Instagram in particular).
# Leave blank unless you understand the ToS implications for your account.
YTDLP_COOKIES_FILE=
INSTAGRAM_COOKIES_FILE=

# ============================================================================
# Storage (temp files + large-file delivery links)
# ============================================================================

# Base directory for per-job scratch space and (if STORAGE_BACKEND=local)
# large downloaded files awaiting delivery. If you're using docker-compose.yml,
# leave this to the compose file's own value (a named volume mounted at /data).
WORKDIR=/data/tmp
TEMP_FILE_MAX_AGE_MINUTES=60

# "local" (default, zero AWS setup required -- see ARCHITECTURE.md §9/§11)
# or "s3" (recommended once you outgrow a single box).
STORAGE_BACKEND=local

# REQUIRED when STORAGE_BACKEND=local: the public HTTPS/HTTP address users'
# Telegram clients will use to fetch a large-file download link, e.g.
# https://bot.example.com (webhook mode, same domain as WEBHOOK_BASE_URL) or
# http://YOUR_SERVER_IP:8080 (long-polling mode on a bare EC2 instance with
# WEB_SERVER_PORT reachable). See the README's "Large files" section.
PUBLIC_BASE_URL=

# Only used when STORAGE_BACKEND=s3.
S3_BUCKET=
S3_REGION=us-east-1
# Leave blank for real AWS S3; set this for an S3-compatible provider
# (MinIO, DigitalOcean Spaces, Cloudflare R2, Backblaze B2, ...).
S3_ENDPOINT_URL=
# Leave both blank on AWS to use the standard credential chain (IAM
# instance role / environment / shared config) instead of long-lived keys.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PRESIGNED_URL_TTL_SECONDS=3600

# ============================================================================
# Rate limiting / abuse prevention
# ============================================================================

# Cold, env-sourced defaults -- admins can override each of these live at
# runtime (stored in the bot_settings table) without a redeploy, see
# ARCHITECTURE.md §10 and app/bot/middlewares/throttling.py.
RATE_LIMIT_RECOGNIZE_PER_MINUTE=5
RATE_LIMIT_DOWNLOAD_PER_MINUTE=5
RATE_LIMIT_CONVERT_PER_MINUTE=5
RATE_LIMIT_GLOBAL_BURST_PER_MINUTE=12

# ============================================================================
# Data retention
# ============================================================================

# How long completed/failed `jobs` rows are kept before a daily cron job
# prunes them (see app/workers/settings.py's prune_old_jobs_cron). This is
# metadata only (status, timestamps, platform) -- raw media is never
# persisted beyond the lifetime of the job that processed it.
JOBS_RETENTION_DAYS=30

# ============================================================================
# Logging
# ============================================================================

LOG_LEVEL=INFO
# true = structured JSON lines (recommended for `docker logs` / CloudWatch
# agent / any log shipper). false = human-readable colored console output,
# nicer while developing locally.
LOG_JSON=true

# ============================================================================
# i18n
# ============================================================================

# Language a brand-new user gets before they ever pick one explicitly.
# One of: uz, ru, en.
DEFAULT_LANGUAGE=uz
